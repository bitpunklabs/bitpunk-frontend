# Optional public configuration. Never place credentials in NEXT_PUBLIC_ values.
NEXT_PUBLIC_SITE_URL=https://bitpunk.io
# Optional local source-build preview. Original art stays in place.
# BITPUNK_ASSET_MODE=placeholder
# X public profile, e.g. https://x.com/your_handle (not a status URL).
NEXT_PUBLIC_X_URL=
# Substack publication homepage, including a custom domain; /feed is derived.
# Use the publication URL, not a substack.com/@profile URL.
NEXT_PUBLIC_BLOG_URL=
# Optional server-side feed URL override. Usually leave blank.
SUBSTACK_RSS_URL=
NEXT_PUBLIC_TRADINGVIEW_URL=
NEXT_PUBLIC_DISCORD_INVITE_URL=
# Optional individual posts while profile/feed configuration is still empty.
NEXT_PUBLIC_X_POST_URL=
NEXT_PUBLIC_SUBSTACK_POST_URL=
# For TradingView, copy an Idea URL and the iframe src from its official embed code.
# Script pages (including Alpha) use a linked chart preview instead.
NEXT_PUBLIC_TRADINGVIEW_IDEA_URL=
NEXT_PUBLIC_TRADINGVIEW_IDEA_EMBED_URL=
