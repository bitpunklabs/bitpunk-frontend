{
  "name": "bitpunk-site",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node tools/check-private-assets.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "assets:check": "node tools/check-private-assets.mjs",
